# Скопируйте в .env и заполните.
# Файл .env в git не попадает.
#
# Для запуска через docker compose переменные DATABASE_URL
# переопределяются в compose.yaml на адрес db:5432 —
# локальный .env при этом остаётся валидным для разработки.

# --- База данных (локальная разработка) ---
POSTGRES_USER=edu
POSTGRES_PASSWORD=edu
POSTGRES_DB=edu
DATABASE_URL=postgresql+psycopg://edu:edu@localhost:5432/edu

# --- Данные ---
# Путь к папке с реальными документами ОП на вашей машине.
# Реальные документы в git не кладём (см. data/README.md).
DATA_DIR=

# --- LLM ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# OpenAI-совместимый эндпоинт (LiteLLM), например https://host/v1
LLM_BASE_URL=
# Лимит запросов в минуту у ключа (если есть). Без него клиент не выдерживает паузы между
# вызовами и упирается в 429 (у общего ключа проекта лимит 2 запроса в минуту).
LLM_RPM=
EMBEDDING_MODEL=

# --- Приложение ---
LOG_LEVEL=INFO
